# Chave gratuita em https://console.groq.com (API Keys > Create API Key)
GROQ_API_KEY=
# Opcional: ordem dos modelos tentados (o próximo é usado se o anterior bater no limite)
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# Opcional: limite de execuções do agente por pessoa (IP), para um visitante não esgotar a cota dos outros
# LIMITE_POR_MINUTO=3
# LIMITE_POR_DIA=25
# Opcional: outro endpoint compatível com a API da OpenAI (ex.: um mock local para testes)
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
